---
// One row of a /feed table. `cols` picks the cells (and must match the
// table's header); see src/pages/feed/index.astro.
import { type ReadingItem, fmtBytes, fmtLength, estimate } from '../lib/reading';
import { SHOW_DRAFTS, formatDate } from '../lib/site';

export type FeedCol = 'title' | 'date' | 'read' | 'length' | 'size' | 'actions';
// What the date cell holds: when added, when published, an editable scheduled
// publish day (owner), or nothing.
export type DateMode = 'added' | 'published' | 'schedule' | 'blank';

interface Props {
  item: ReadingItem;
  cols: FeedCol[];
  biggest?: number; // largest episode in bytes, scales the size bars
  dateMode?: DateMode;
}
const { item: i, cols, biggest = 1, dateMode = 'added' } = Astro.props;
const isEpisode = i.listen === 'ready';
const published = isEpisode && !i.articleDraft;
const bytes = i.audioBytes ?? 0;
// Not narrated yet: estimate length/size from the clean text (shown with "~").
const est = isEpisode ? undefined : estimate(i.chars);
// Sorts on the words, not leading quotes/punctuation.
const sortTitle = i.title.toLowerCase().replace(/^[^\p{L}\p{N}]+/u, '');
const iso = (d?: Date) => (d ? d.toISOString().slice(0, 10) : '');
const sortDate =
  dateMode === 'added' ? i.date.valueOf()
  : dateMode === 'published' ? (published && i.feedDate ? i.feedDate.valueOf() : 0)
  : dateMode === 'schedule' ? (i.publishOn?.valueOf() ?? 0)
  : 0;
const listenIcon = { none: '+', queued: '≡', in_progress: '⏳', ready: '▶' };
---
<tr
  data-key={i.key}
  data-title={i.title}
  data-url={i.url}
  data-date={i.date.valueOf()}
  data-listen={i.listen}
  data-note={i.notePath}
  data-article={i.articleFilePath}
  data-audio={i.audio}
  data-bytes={isEpisode ? bytes : undefined}
  data-published={published ? '1' : undefined}
  data-s-title={sortTitle}
  data-feed={i.feedDate?.valueOf()}
  data-publish-on={i.publishOn?.valueOf()}
  data-s-date={sortDate}
  data-est-secs={est?.secs}
  data-est-bytes={est?.bytes}
  data-s-length={i.duration ?? est?.secs ?? 0}
  data-s-size={bytes || est?.bytes || 0}
>
  {cols.map((c) => {
    if (c === 'title') return (
      <td class="title" title={i.title}>
        <div class="title-text">{i.title}</div>
        {SHOW_DRAFTS && (
          <span class="row-ops">
            <button type="button" class="row-op" data-op="to-notes" title="Move to notes (off the list)">→ note</button>
          </span>
        )}
      </td>
    );
    if (c === 'date') return (
      <td class="date">
        {dateMode === 'added' && formatDate(i.date)}
        {dateMode === 'published' && (published && i.feedDate ? formatDate(i.feedDate) : '')}
        {dateMode === 'schedule' && SHOW_DRAFTS && (
          <input type="date" class="publish-on" value={iso(i.publishOn)} min={iso(new Date())}
            title="Publish on this day (blank = stays unpublished until you publish it)"
            aria-label="Scheduled publish date" />
        )}
      </td>
    );
    if (c === 'read') return (
      <td class="read">
        <a href={i.url}>original</a>
        {i.hasArticle ? (
          <a href={`/feed/${i.slug}`}>md</a>
        ) : (
          <span class="pending" title="clean text not generated yet — queued">md</span>
        )}
      </td>
    );
    if (c === 'length') return <td class="length" title={est ? 'estimated from the clean text' : undefined}>{est ? `~${fmtLength(est.secs)}` : fmtLength(i.duration)}</td>;
    if (c === 'size') return (
      <td class="size" title={est ? `~${fmtBytes(est.bytes)} (estimated)` : fmtBytes(bytes)}>
        {isEpisode && <span class="size-bar" style={`width:${(bytes / biggest) * 100}%`}></span>}
        <span class="size-num">{isEpisode ? (bytes / 1e6).toFixed(1) : est ? `~${(est.bytes / 1e6).toFixed(1)}` : ''}</span>
      </td>
    );
    if (c === 'actions') return (
      <td class="actions">
        {isEpisode ? (
          <a class="listen-view" href={i.audio} title="listen">▶</a>
        ) : SHOW_DRAFTS ? (
          <button type="button" class="listen-btn" data-state={i.listen}>{listenIcon[i.listen]}</button>
        ) : null}
        {SHOW_DRAFTS && isEpisode && (
          <button type="button" class="icon-btn publish-btn" data-on={published ? '1' : undefined}
            title={published ? 'Unpublish — take it out of the podcast feed' : 'Publish to the podcast feed'}
            aria-label={published ? 'Unpublish' : 'Publish'}>
            <span class="material-symbols-outlined" aria-hidden="true">{published ? 'cloud_off' : 'cloud_upload'}</span>
          </button>
        )}
        {SHOW_DRAFTS && (
          <button type="button" class="icon-btn danger delete-btn"
            title="Delete completely (link, text and any episode audio)" aria-label="Delete">
            <span class="material-symbols-outlined" aria-hidden="true">delete</span>
          </button>
        )}
      </td>
    );
    return null;
  })}
</tr>
