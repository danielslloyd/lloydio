---
import Base from '../../layouts/Base.astro';
import FeedRow, { type FeedCol, type DateMode } from '../../components/FeedRow.astro';
import { getReadingItems, FEED_STORAGE_LIMIT, FEED_URL, fmtBytes, fmtLength, estimate } from '../../lib/reading';
import { SHOW_DRAFTS } from '../../lib/site';

const items = await getReadingItems();
// Right column / public page: published episodes — exactly what
// /podcast/<FEED_TOKEN>.xml carries (narrated, article not a draft), newest
// publish first. Left column (owner only), the hopper: everything else,
// including narrated drafts waiting to be published.
const byFeedDate = (a: (typeof items)[number], b: (typeof items)[number]) =>
  (b.feedDate?.valueOf() ?? 0) - (a.feedDate?.valueOf() ?? 0);
const episodes = items.filter((i) => i.listen === 'ready');
const published = episodes.filter((i) => !i.articleDraft).sort(byFeedDate);
const unpublished = episodes.filter((i) => i.articleDraft);
const waiting = items.filter((i) => i.listen !== 'ready');

// "In progress" is live-only, so those rows sit under "queued" (the owner
// script overlays the state from BacklogCast).
const hopperSections: { id: string; title: string; dateLabel: string; dateMode: DateMode; rows: typeof items }[] = [
  { id: 'unpublished', title: 'queued', dateLabel: 'publish on', dateMode: 'schedule', rows: unpublished },
  { id: 'queued', title: 'narrating', dateLabel: 'date', dateMode: 'blank',
    rows: waiting.filter((i) => i.listen === 'queued') },
  { id: 'none', title: 'inbox', dateLabel: 'added', dateMode: 'added',
    rows: waiting.filter((i) => i.listen === 'none') },
];

// Estimated totals for sections that aren't narrated yet (from clean-text size).
const estTotals = (rows: typeof items) => {
  const e = rows.map((r) => estimate(r.chars)).filter((x) => x);
  return { secs: e.reduce((n, x) => n + x!.secs, 0), bytes: e.reduce((n, x) => n + x!.bytes, 0) };
};

// R2 holds every episode's mp3, published or not.
const bytesOf = (list: typeof items) => list.reduce((n, e) => n + (e.audioBytes ?? 0), 0);
const used = bytesOf(episodes);
const usedPublished = bytesOf(published);
const left = Math.max(0, FEED_STORAGE_LIMIT - used);
const biggest = Math.max(1, ...episodes.map((e) => e.audioBytes ?? 0));
const avg = episodes.length ? used / episodes.length : 0;
const publishedLength = published.reduce((n, e) => n + (e.duration ?? 0), 0);

// Column sets. `sort` makes the header clickable (sorts on data-s-<key>).
type Col = { key: FeedCol; label: string; sort?: 'text' | 'num' };
const C: Record<FeedCol, Col> = {
  title: { key: 'title', label: 'title', sort: 'text' },
  date: { key: 'date', label: 'date', sort: 'num' },
  read: { key: 'read', label: 'read' },
  length: { key: 'length', label: 'length', sort: 'num' },
  size: { key: 'size', label: 'size', sort: 'num' },
  actions: { key: 'actions', label: '' },
};
// All three hopper groups share one column set; only the date header/content
// differs. The owner script rewrites the date cell as rows move between groups.
const hopperCols = [C.title, C.date, C.read, C.length, C.size, C.actions];
const episodeCols = SHOW_DRAFTS ? hopperCols : [C.title, C.date, C.read, C.length, C.actions];
---
<Base title="Feed">
  {SHOW_DRAFTS && (
    <link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=cloud_off,cloud_upload,delete&display=block" />
  )}
  <div class:list={['feed-page', { owner: SHOW_DRAFTS, editing: SHOW_DRAFTS }]}>
  <h1 class="page-title">Feed</h1>
  <p class="feed-url">
    <span class="label">podcast feed</span>
    <span id="feed-url">{FEED_URL}</span>
    <button type="button" id="copy-feed" class="chip" title="Copy the feed URL">copy</button>
  </p>
  {SHOW_DRAFTS ? (
    <p class="meta"><a href="/api/podcast-queue.json">queue.json</a></p>
  ) : (
    <p class="meta"><span data-count="feed">{published.length}</span> episodes · {fmtLength(publishedLength)}</p>
  )}

  <div class="feed-grid">
    {SHOW_DRAFTS && (
      <section class="hopper">
        {hopperSections.map((sec) => {
          const cols = hopperCols;
          const est = sec.id === 'unpublished' ? undefined : estTotals(sec.rows);
          return (
            <details class="reading-section" data-section={sec.id} open
              data-empty={sec.rows.length ? undefined : ''}>
              <summary>
                <h2>{sec.title} <span class="count">{sec.rows.length}</span></h2>
                {est && (
                  <span class="est-total" data-est-total>
                    {est.secs > 0 ? `~${fmtLength(est.secs)} · ~${fmtBytes(est.bytes)}` : ''}
                  </span>
                )}
              </summary>
              {sec.id === 'none' && (
                <form id="add-reading" class="add-reading">
                  <input type="url" name="url" placeholder="paste a URL (article or PDF)"
                    aria-label="URL to add" autocomplete="off" required />
                  <input type="text" name="title" placeholder="title (optional)" aria-label="Title (optional)"
                    autocomplete="off" class="title-input" />
                  <label class="listen-opt"><input type="checkbox" name="podcast" checked /> queue</label>
                  <button type="submit" class="act">add</button>
                  <span class="add-msg" role="status"></span>
                </form>
              )}
              <table class:list={['reading-table', sec.id === 'unpublished' ? 'episode-table' : 'hopper-table']}>
                <colgroup>{cols.map((c) => <col class={`col-${c.key}`} />)}</colgroup>
                <thead>
                  <tr>{cols.map((c) => (
                    <th data-sort={c.sort ? c.key : undefined} data-sort-type={c.sort}>
                      {c.key === 'date' ? sec.dateLabel : c.label}
                    </th>
                  ))}</tr>
                </thead>
                <tbody>
                  {sec.rows.map((i) => <FeedRow item={i} cols={cols.map((c) => c.key)} biggest={biggest} dateMode={sec.dateMode} />)}
                </tbody>
              </table>
            </details>
          );
        })}
      </section>
    )}

    <section class="feed-col">
      {SHOW_DRAFTS && (
        <>
          <div class="storage" data-limit={FEED_STORAGE_LIMIT}>
            <div class="meter" role="img"
              aria-label={`${fmtBytes(used)} of ${fmtBytes(FEED_STORAGE_LIMIT)} used`}>
              <span class="meter-used published" style={`width:${(usedPublished / FEED_STORAGE_LIMIT) * 100}%`}></span>
              <span class="meter-used unpublished" style={`width:${((used - usedPublished) / FEED_STORAGE_LIMIT) * 100}%`}></span>
            </div>
            <p class="storage-legend">
              <b data-storage="used">{fmtBytes(used)}</b> used of {fmtBytes(FEED_STORAGE_LIMIT)} free (R2) ·
              <b data-storage="left">{fmtBytes(left)}</b> left
              {avg > 0 && <> · room for ~<span data-storage="more">{Math.floor(left / avg)}</span> more episodes</>}
            </p>
            <p class="zoom-label">
              <span class="key"><i class="sw published"></i>published (<span data-count="feed">{published.length}</span>) <span data-storage="pub">{fmtBytes(usedPublished)}</span></span>
              <span class="key"><i class="sw unpublished"></i>not published (<span data-count="unpub">{unpublished.length}</span>) <span data-storage="unpub">{fmtBytes(used - usedPublished)}</span></span>
            </p>
            <div class="zoom" aria-hidden="true">
              {[...published, ...unpublished].map((e) => (
                <span class:list={['seg', { unpublished: e.articleDraft }]} data-key={e.key}
                  style={`flex-grow:${e.audioBytes ?? 0}`}
                  title={`${e.title} — ${fmtBytes(e.audioBytes ?? 0)}`}></span>
              ))}
            </div>
          </div>
        </>
      )}
      <table class="reading-table episode-table feed-table" data-empty-msg="No episodes yet.">
        <colgroup>{episodeCols.map((c) => <col class={`col-${c.key}`} />)}</colgroup>
        <thead>
          <tr>{episodeCols.map((c) => (
            <th data-sort={c.sort ? c.key : undefined} data-sort-type={c.sort}
              aria-sort={c.key === 'date' ? 'descending' : undefined}>{c.key === 'date' ? 'published' : c.label}</th>
          ))}</tr>
        </thead>
        <tbody>
          {published.map((i) => <FeedRow item={i} cols={episodeCols.map((c) => c.key)} biggest={biggest} dateMode="published" />)}
        </tbody>
      </table>
      {published.length === 0 && <p>No episodes yet.</p>}
    </section>
  </div>
  </div>
</Base>

<script is:inline>
  (function () {
    const copy = document.getElementById('copy-feed');
    const url = document.getElementById('feed-url');
    if (copy && url) {
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url.textContent.trim());
          copy.textContent = 'copied';
        } catch {
          getSelection().selectAllChildren(url);
          copy.textContent = 'press ⌘/ctrl-C';
        }
        setTimeout(() => (copy.textContent = 'copy'), 1800);
      });
    }

    // Sortable headers: click to sort by that column, click again to flip.
    // Rows carry their sort values as data-s-<key>.
    document.querySelectorAll('.feed-page th[data-sort]').forEach((th) => {
      th.tabIndex = 0;
      const run = () => {
        const table = th.closest('table');
        const key = 's' + th.dataset.sort.replace(/^./, (c) => c.toUpperCase());
        const text = th.dataset.sortType === 'text';
        // First click: A→Z for text, biggest/newest first for numbers.
        const desc = th.getAttribute('aria-sort')
          ? th.getAttribute('aria-sort') === 'ascending'
          : !text;
        table.querySelectorAll('th[aria-sort]').forEach((h) => h.removeAttribute('aria-sort'));
        th.setAttribute('aria-sort', desc ? 'descending' : 'ascending');
        const tbody = table.tBodies[0];
        const rows = [...tbody.rows];
        rows.sort((a, b) => {
          const x = a.dataset[key] ?? '';
          const y = b.dataset[key] ?? '';
          const d = text ? x.localeCompare(y) : Number(x) - Number(y);
          return desc ? -d : d;
        });
        tbody.append(...rows);
      };
      th.addEventListener('click', run);
      th.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); run(); }
      });
    });

    // Collapsible hopper sections remember their state (this browser only).
    document.querySelectorAll('.feed-page details[data-section]').forEach((d) => {
      const k = 'lloydio_feed_open_' + d.dataset.section;
      try {
        const v = localStorage.getItem(k);
        if (v !== null) d.open = v === '1';
      } catch {}
      d.addEventListener('toggle', () => {
        try { localStorage.setItem(k, d.open ? '1' : '0'); } catch {}
      });
    });

    // Live extraction state for links without clean text yet (BacklogCast
    // reports it; see functions/_episodes.js). Distinguishes a "md" that's
    // still coming from one that failed. The owner script reuses the fetch.
    const titles = {
      in_progress: 'extracting clean text…',
      waiting: 'extraction failed — will retry',
      failed: 'extraction failed',
    };
    window.readingStatus = function () {
      return fetch('/api/episode-status', { credentials: 'include' })
        .then((r) => (r.ok ? r.json() : {}))
        .catch(() => ({}));
    };
    if (!document.querySelector('.read .pending')) return;
    window.readingStatusOnce = window.readingStatus();
    window.readingStatusOnce.then(({ text = {} }) => {
      document.querySelectorAll('.reading-table tbody tr[data-key]').forEach((row) => {
        const s = text[row.dataset.key];
        const md = row.querySelector('.read .pending');
        if (!s || !md || !titles[s.state]) return;
        md.dataset.text = s.state;
        md.title = titles[s.state] + (s.reason ? ': ' + s.reason : '');
      });
    });
  })();
</script>

{SHOW_DRAFTS && (
  <script is:inline>
    (function () {
      // Owner-mode editing: the add box, the hopper's LISTEN buttons, publish /
      // unpublish, and deleting episodes. Same auth pattern as the /books add
      // box — the Access cookie rides along; the shared token is only a 401
      // fallback.
      const API = '/api/reading';
      const TOKEN_KEY = 'lloydio_owner_token';
      const listenIcon = { none: '+', queued: '≡', in_progress: '⏳', ready: '▶' };
      const form = document.getElementById('add-reading');
      const page = document.querySelector('.feed-page');
      if (!form || !page) return;
      const urlInput = form.querySelector('input[name=url]');
      const titleInput = form.querySelector('input[name=title]');
      const podcastInput = form.querySelector('input[name=podcast]');
      const msg = form.querySelector('.add-msg');
      const feedBody = document.querySelector('.feed-table tbody');
      const tbodyOf = (id) => document.querySelector('.reading-section[data-section="' + id + '"] tbody');

      const titles = {
        none: 'not queued — click to queue for narration',
        queued: 'queued — click to un-queue',
        in_progress: 'being narrated — click to cancel',
      };

      function setListen(row, state) {
        row.dataset.listen = state;
        const btn = row.querySelector('.listen-btn');
        if (!btn) return;
        const failed = row.dataset.failed ? ' (last attempt failed)' : '';
        btn.textContent = listenIcon[state];
        btn.title = (titles[state] || '') + failed;
        btn.dataset.state = state;
      }

      // The date cell depends on the group: added (inbox), blank (narrating),
      // an editable publish-on day (queued), or the publish date (feed).
      const iso = (ms) => new Date(Number(ms)).toISOString().slice(0, 10);
      const modeOf = { unpublished: 'schedule', queued: 'blank', none: 'added' };
      function setDate(row, mode) {
        const td = row.querySelector('td.date');
        if (!td) return;
        td.replaceChildren();
        let sort = 0;
        if (mode === 'added') {
          td.textContent = iso(row.dataset.date);
          sort = row.dataset.date;
        } else if (mode === 'published') {
          const ms = Number(row.dataset.feed) || Date.now();
          td.textContent = iso(ms);
          sort = ms;
        } else if (mode === 'schedule') {
          const input = document.createElement('input');
          input.type = 'date';
          input.className = 'publish-on';
          input.min = iso(Date.now());
          input.setAttribute('aria-label', 'Scheduled publish date');
          input.title = 'Publish on this day (blank = stays unpublished until you publish it)';
          if (row.dataset.publishOn) {
            input.value = iso(row.dataset.publishOn);
            sort = row.dataset.publishOn;
          }
          td.append(input);
        }
        row.dataset.sDate = sort;
      }

      // Puts a row at the top of a tbody, or in date order when `byDate`.
      function moveTo(row, tbody, byDate) {
        if (!tbody || row.parentElement === tbody) return;
        const date = Number(row.dataset.date || Date.now());
        const after = byDate ? [...tbody.rows].find((r) => Number(r.dataset.date || 0) < date) : tbody.rows[0];
        tbody.insertBefore(row, after || null);
      }

      const fmtBytes = (b) => (b >= 1e9 ? (b / 1e9).toFixed(2) + ' GB' : (b / 1e6).toFixed(b >= 1e8 ? 0 : 1) + ' MB');
      const pct = (b, limit) => (b / limit) * 100 + '%';
      function recount() {
        document.querySelectorAll('.reading-section').forEach((sec) => {
          const n = sec.querySelectorAll('tbody tr').length;
          sec.querySelector('.count').textContent = n;
          if (n) delete sec.dataset.empty;
          else sec.dataset.empty = '';
        });
        const pub = [...feedBody.rows];
        const unpub = [...tbodyOf('unpublished').rows];
        document.querySelectorAll('[data-count="feed"]').forEach((el) => (el.textContent = pub.length));
        document.querySelectorAll('[data-count="unpub"]').forEach((el) => (el.textContent = unpub.length));
        // Estimated length/size totals for the not-yet-narrated sections.
        document.querySelectorAll('.reading-section').forEach((sec) => {
          const out = sec.querySelector('[data-est-total]');
          if (!out) return;
          let secs = 0, bytes = 0;
          sec.querySelectorAll('tbody tr').forEach((r) => {
            secs += Number(r.dataset.estSecs || 0);
            bytes += Number(r.dataset.estBytes || 0);
          });
          const h = Math.floor(secs / 3600), m = Math.floor((secs % 3600) / 60);
          const sc = String(Math.round(secs % 60)).padStart(2, '0');
          const len = h ? h + ':' + String(m).padStart(2, '0') + ':' + sc : m + ':' + sc;
          out.textContent = secs ? '~' + len + ' · ~' + fmtBytes(bytes) : '';
        });
        // Storage follows the episode rows (published or not — R2 holds both).
        const storage = document.querySelector('.storage');
        const limit = Number(storage.dataset.limit);
        const sum = (rows) => rows.reduce((n, r) => n + Number(r.dataset.bytes || 0), 0);
        const usedPub = sum(pub);
        const used = usedPub + sum(unpub);
        const left = Math.max(0, limit - used);
        storage.querySelector('.meter-used.published').style.width = pct(usedPub, limit);
        storage.querySelector('.meter-used.unpublished').style.width = pct(used - usedPub, limit);
        storage.querySelector('[data-storage="used"]').textContent = fmtBytes(used);
        storage.querySelector('[data-storage="left"]').textContent = fmtBytes(left);
        storage.querySelector('[data-storage="pub"]').textContent = fmtBytes(usedPub);
        storage.querySelector('[data-storage="unpub"]').textContent = fmtBytes(used - usedPub);
        const n = pub.length + unpub.length;
        const more = storage.querySelector('[data-storage="more"]');
        if (more && n) more.textContent = Math.floor(left / (used / n));
        // Rebuild the per-episode strip in the same order.
        const zoom = storage.querySelector('.zoom');
        const segs = new Map([...zoom.children].map((s) => [s.dataset.key, s]));
        zoom.replaceChildren(...[...pub, ...unpub].map((r) => {
          const s = segs.get(r.dataset.key) || document.createElement('span');
          s.className = 'seg' + (r.dataset.published ? '' : ' unpublished');
          s.dataset.key = r.dataset.key;
          s.style.flexGrow = r.dataset.bytes || 0;
          s.title = r.dataset.title + ' — ' + fmtBytes(Number(r.dataset.bytes || 0));
          return s;
        }));
      }

      // Storage strip segment ↔ table row highlight.
      page.addEventListener('mouseover', (ev) => {
        const el = ev.target.closest('.seg, .episode-table tbody tr');
        document.querySelectorAll('.hot').forEach((x) => x.classList.remove('hot'));
        if (!el) return;
        document.querySelectorAll('[data-key="' + CSS.escape(el.dataset.key) + '"]').forEach((x) => {
          if (x.matches('.seg, .episode-table tr')) x.classList.add('hot');
        });
      });

      // "In progress" isn't in the repo — BacklogCast reports it live.
      async function overlayLiveStatus(pending) {
        try {
          const { statuses = {} } = await pending;
          document.querySelectorAll('.hopper-table tbody tr[data-key]').forEach((row) => {
            const s = statuses[row.dataset.key];
            if (!s) return;
            if (s.state === 'in_progress') setListen(row, 'in_progress');
            else if (s.state === 'failed') {
              row.dataset.failed = '1';
              setListen(row, row.dataset.listen);
            }
          });
        } catch {
          // live status is a nicety; the column still works without it
        }
      }
      document.querySelectorAll('.hopper-table tbody tr').forEach((r) => setListen(r, r.dataset.listen));
      overlayLiveStatus(window.readingStatusOnce || window.readingStatus());

      function post(payload, token) {
        const headers = { 'Content-Type': 'application/json' };
        if (token) headers.Authorization = 'Bearer ' + token;
        return fetch(API, { method: 'POST', headers, body: payload, credentials: 'include' });
      }

      async function send(body) {
        const payload = JSON.stringify(body);
        let res = await post(payload, localStorage.getItem(TOKEN_KEY) || '');
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          const t = (prompt('Not authenticated. Owner token (CAPTURE_TOKEN):') || '').trim();
          if (!t) throw new Error('unauthorized');
          localStorage.setItem(TOKEN_KEY, t);
          res = await post(payload, t);
          if (res.status === 401) {
            localStorage.removeItem(TOKEN_KEY);
            throw new Error('unauthorized — token rejected');
          }
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'request failed (' + res.status + ')');
        return data;
      }

      function say(text, kind) {
        msg.textContent = text;
        msg.dataset.kind = kind || '';
      }

      // Each action is a git commit; chain them so quick successive clicks don't race.
      let chain = Promise.resolve();
      function enqueue(task) {
        const run = chain.then(task, task);
        chain = run.then(() => {}, () => {});
        return run;
      }

      // Runs one row action with the row greyed out; `ask` is a confirm prompt.
      function act(row, btn, ask, body, done, verb) {
        if (ask && !confirm(ask)) return;
        btn.disabled = true;
        row.classList.add('saving');
        enqueue(async () => {
          try {
            done(await send(body));
            row.title = 'Saved — the site catches up after the next rebuild';
          } catch (e) {
            alert('Could not ' + verb + ': ' + e.message);
          } finally {
            btn.disabled = false;
            row.classList.remove('saving');
          }
        });
      }

      page.addEventListener('click', (ev) => {
        const btn = ev.target.closest('button');
        if (!btn) return;
        const row = btn.closest('tr');
        if (!row) return;
        const title = row.dataset.title || 'this item';
        const ids = {
          slug: row.dataset.key,
          notePath: row.dataset.note || undefined,
          articlePath: row.dataset.article || undefined,
          audio: row.dataset.audio || undefined,
        };

        // ---- hopper LISTEN: queue / unqueue / cancel ----
        if (btn.matches('.listen-btn')) {
          const op = { none: 'queue', queued: 'unqueue', in_progress: 'cancel' }[row.dataset.listen];
          if (!op) return;
          act(row, btn, op === 'cancel' && 'Cancel narration of “' + title + '”?',
            { action: 'listen', op, ...ids }, (res) => {
              delete row.dataset.failed;
              setListen(row, res.listen);
              const target = res.listen === 'in_progress' ? 'queued' : res.listen;
              setDate(row, modeOf[target]);
              moveTo(row, tbodyOf(target), true);
              recount();
            }, op);
          return;
        }

        // ---- publish / unpublish ----
        if (btn.matches('.publish-btn')) {
          const on = !row.dataset.published;
          act(row, btn, null, { action: 'publish', on, articlePath: ids.articlePath }, (res) => {
            const icon = btn.querySelector('.material-symbols-outlined');
            if (on) {
              row.dataset.published = '1';
              row.dataset.feed = Date.parse(res.feedDate) || Date.now();
              delete row.dataset.publishOn;
              setDate(row, 'published');
              moveTo(row, feedBody, false);
            } else {
              delete row.dataset.published;
              setDate(row, 'schedule');
              moveTo(row, tbodyOf('unpublished'), true);
            }
            btn.dataset.on = on ? '1' : '';
            icon.textContent = on ? 'cloud_off' : 'cloud_upload';
            btn.title = on ? 'Unpublish — take it out of the podcast feed' : 'Publish to the podcast feed';
            btn.setAttribute('aria-label', on ? 'Unpublish' : 'Publish');
            recount();
          }, on ? 'publish' : 'unpublish');
          return;
        }

        // ---- delete: removes the link, its text and any episode audio ----
        if (btn.matches('.delete-btn')) {
          const extra = row.dataset.article
            ? '\n\nIts clean text' + (row.dataset.audio ? ' and episode audio' : '') + ' will be deleted too.'
            : '';
          act(row, btn, 'Delete “' + title + '” completely?' + extra,
            { action: 'remove', op: 'delete', url: row.dataset.url, title: row.dataset.title, ...ids },
            () => {
              row.remove();
              recount();
            }, 'delete');
          return;
        }

        // ---- remove / move to notes (edit mode) ----
        if (btn.matches('.row-op')) {
          const op = btn.dataset.op;
          const extra = row.dataset.article
            ? '\n\nIts clean text' + (row.dataset.audio ? ' and episode audio' : '') + ' will be deleted.'
            : '';
          const ask = op === 'delete'
            ? 'Delete “' + title + '”?' + extra
            : 'Move “' + title + '” to notes? It leaves the feed and stays as a note.' + extra;
          act(row, btn, ask, { action: 'remove', op, url: row.dataset.url, title: row.dataset.title, ...ids },
            () => {
              row.remove();
              recount();
            }, op === 'delete' ? 'delete' : 'move to notes');
        }
      });

      // ---- scheduled publish day (queued group) ----
      page.addEventListener('change', (ev) => {
        const input = ev.target.closest('.publish-on');
        if (!input) return;
        const row = input.closest('tr');
        if (!row.dataset.article) return;
        const date = input.value;
        act(row, input, null, { action: 'schedule', articlePath: row.dataset.article, date }, () => {
          if (date) row.dataset.publishOn = Date.parse(date);
          else delete row.dataset.publishOn;
          row.dataset.sDate = row.dataset.publishOn || 0;
        }, 'schedule');
      });

      // ---- add row ------------------------------------------------------------
      // A placeholder row until the rebuild lists it for real.
      function placeholderRow(url, title, listen) {
        const tbody = tbodyOf(listen);
        if (!tbody) return;
        const tr = document.createElement('tr');
        tr.className = 'just-added';
        tr.title = 'Added — appears for good after the site rebuilds';
        tr.dataset.sTitle = (title || url).toLowerCase();
        tr.dataset.sDate = listen === 'none' ? Date.now() : 0;
        const td = (cls, text) => {
          const el = document.createElement('td');
          el.className = cls;
          if (text) el.textContent = text;
          return el;
        };
        const readTd = td('read');
        const orig = document.createElement('a');
        orig.href = url;
        orig.textContent = 'original';
        const md = document.createElement('span');
        md.className = 'pending';
        md.textContent = 'md';
        readTd.append(orig, md);
        tr.append(td('title', title || url),
          td('date', listen === 'none' ? new Date().toISOString().slice(0, 10) : ''),
          readTd, td('length'), td('size'), td('actions', listenIcon[listen]));
        tbody.prepend(tr);
        recount();
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const url = urlInput.value.trim();
        const title = titleInput.value.trim();
        const podcast = podcastInput.checked;
        if (!url) return;
        urlInput.value = '';
        titleInput.value = '';
        say('adding…');
        enqueue(async () => {
          try {
            const res = await send({ action: 'add', url, title, podcast });
            if (res.result === 'duplicate') {
              say('already on the list: ' + (res.title || url) + ' (' + res.status + ')', 'warn');
            } else {
              placeholderRow(url, title, res.listen);
              say(podcast
                ? 'added and queued for narration — BacklogCast picks it up after the next rebuild'
                : 'added — appears after the next rebuild', 'ok');
            }
          } catch (e) {
            say('add failed: ' + e.message, 'err');
          }
        });
        urlInput.focus();
      });
    })();
  </script>
)}

