---
import Base from '../../layouts/Base.astro';
import { getReadingItems, FEED_STORAGE_LIMIT, FEED_URL } from '../../lib/reading';
import { SHOW_DRAFTS, formatDate } from '../../lib/site';

const items = await getReadingItems();
// The feed: narrated items — what /podcast/<FEED_TOKEN>.xml carries (public
// builds leave out drafts). The hopper: everything else, owner mode only.
// "In progress" is live-only, so those rows sit under "queued" (the owner
// script overlays the state from BacklogCast).
const episodes = items.filter((i) => i.listen === 'ready');
const hopper = items.filter((i) => i.listen !== 'ready');
const hopperSections = [
  { id: 'queued', title: 'queued for narration' },
  { id: 'none', title: 'not queued' },
] as const;

const used = episodes.reduce((n, e) => n + (e.audioBytes ?? 0), 0);
const left = Math.max(0, FEED_STORAGE_LIMIT - used);
const biggest = Math.max(1, ...episodes.map((e) => e.audioBytes ?? 0));
const avg = episodes.length ? used / episodes.length : 0;

function fmtBytes(b: number): string {
  if (b >= 1e9) return `${(b / 1e9).toFixed(2)} GB`;
  return `${(b / 1e6).toFixed(b >= 1e8 ? 0 : 1)} MB`;
}
function fmtLength(s?: number): string {
  if (!s) return '—';
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const sec = String(Math.round(s % 60)).padStart(2, '0');
  return h ? `${h}:${String(m).padStart(2, '0')}:${sec}` : `${m}:${sec}`;
}
// Drafts stay out of the podcast XML; owner mode still lists them (their mp3s
// use storage) but the headline counts only what the feed publishes.
const published = episodes.filter((e) => !e.draft);
const publishedLength = published.reduce((n, e) => n + (e.duration ?? 0), 0);

// LISTEN column glyphs, shared with the owner-mode editor script below.
const listenIcon = { none: '+', queued: '≡', in_progress: '⏳', ready: '▶' };
---
<Base title="Feed">
  <div class:list={['feed-page', { owner: SHOW_DRAFTS }]}>
  <h1 class="page-title">Feed</h1>
  <p class="feed-url">
    <span class="label">podcast feed</span>
    <code id="feed-url">{FEED_URL}</code>
    <button type="button" id="copy-feed" class="chip" title="Copy the feed URL">copy</button>
  </p>
  <p class="meta">
    articles narrated into a private podcast — subscribe with the URL above in any podcast app ·
    {published.length} episodes · {fmtLength(publishedLength)}
    {SHOW_DRAFTS && (
      <>
        · <a href="/api/podcast-queue.json">queue.json</a>
        <button id="feed-edit-toggle" class="chip edit-toggle" type="button" aria-pressed="false">edit</button>
      </>
    )}
  </p>

  <div class="feed-grid">
    {SHOW_DRAFTS && (
      <section class="hopper" aria-labelledby="hopper-h">
        <h2 id="hopper-h">hopper <span class="count" data-count="hopper">{hopper.length}</span></h2>
        <p class="col-help">links waiting to be narrated — BacklogCast takes the queued ones</p>
        <form id="add-reading" class="add-reading" hidden>
          <input type="url" name="url" placeholder="paste a URL (article or PDF)"
            aria-label="URL to add" autocomplete="off" required />
          <input type="text" name="title" placeholder="title (optional)" aria-label="Title (optional)"
            autocomplete="off" class="title-input" />
          <label class="listen-opt"><input type="checkbox" name="podcast" checked /> queue</label>
          <button type="submit" class="act">add</button>
          <span class="add-msg" role="status"></span>
        </form>
        {hopperSections.map((sec) => {
          const rows = hopper.filter((i) => i.listen === sec.id);
          return (
            <section class="reading-section" data-section={sec.id} data-empty={rows.length ? undefined : ''}>
              <h3>{sec.title} <span class="count">{rows.length}</span></h3>
              <table class="reading-table owner hopper-table">
                <colgroup><col /><col class="col-read" /><col class="col-listen" /></colgroup>
                <thead><tr><th>title</th><th>read</th><th>listen</th></tr></thead>
                <tbody>
                  {rows.map((i) => (
                    <tr data-key={i.key} data-title={i.title} data-url={i.url} data-date={i.date.valueOf()}
                      data-listen={i.listen} data-note={i.notePath} data-article={i.articleFilePath}>
                      <td class="title" title={`added ${formatDate(i.date)}`}>
                        {i.title}
                        <span class="row-ops">
                          <button type="button" class="row-op" data-op="to-notes" title="Move to notes (off the list)">→ note</button>
                          <button type="button" class="row-op danger" data-op="delete" title="Delete from the list">✕</button>
                        </span>
                      </td>
                      <td class="read">
                        <a href={i.url}>original</a>
                        {i.hasArticle ? (
                          <a href={`/feed/${i.slug}`}>md</a>
                        ) : (
                          <span class="pending" title="clean text not generated yet — queued">md</span>
                        )}
                      </td>
                      <td class="listen">
                        <button type="button" class="listen-btn" data-state={i.listen}>{listenIcon[i.listen]}</button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </section>
          );
        })}
      </section>
    )}

    <section class="feed-col" aria-labelledby="feed-h">
      {SHOW_DRAFTS && (
        <>
          <h2 id="feed-h">feed <span class="count" data-count="feed">{episodes.length}</span></h2>
          <div class="storage" data-limit={FEED_STORAGE_LIMIT}>
            <div class="meter" role="img"
              aria-label={`${fmtBytes(used)} of ${fmtBytes(FEED_STORAGE_LIMIT)} used`}>
              {episodes.map((e) => (
                <span class="seg" data-key={e.key} data-bytes={e.audioBytes ?? 0}
                  style={`width:${((e.audioBytes ?? 0) / FEED_STORAGE_LIMIT) * 100}%`}
                  title={`${e.title} — ${fmtBytes(e.audioBytes ?? 0)}`}></span>
              ))}
            </div>
            <p class="storage-legend">
              <b data-storage="used">{fmtBytes(used)}</b> used of {fmtBytes(FEED_STORAGE_LIMIT)} free (R2) ·
              <b data-storage="left">{fmtBytes(left)}</b> left
              {avg > 0 && <> · room for ~<span data-storage="more">{Math.floor(left / avg)}</span> more at the average episode size</>}
            </p>
          </div>
        </>
      )}
      {episodes.length === 0 && <p>No episodes yet.</p>}
      {episodes.length > 0 && (
        <table class:list={['reading-table', 'feed-table', { owner: SHOW_DRAFTS }]}>
          <colgroup>
            <col /><col class="col-read" /><col class="col-length" />
            {SHOW_DRAFTS && <col class="col-size" />}
            <col class="col-listen" />
          </colgroup>
          <thead>
            <tr><th>title</th><th>read</th><th>length</th>{SHOW_DRAFTS && <th>size</th>}<th>listen</th></tr>
          </thead>
          <tbody>
            {episodes.map((i) => (
              <tr data-key={i.key} data-title={i.title} data-url={i.url} data-date={i.date.valueOf()}
                data-listen="ready" data-note={i.notePath} data-article={i.articleFilePath}
                data-audio={i.audio} data-bytes={i.audioBytes ?? 0}>
                <td class="title" title={`added ${formatDate(i.date)}`}>
                  {i.title}
                  {i.draft && <span class="draft-tag" title="draft — left out of the podcast XML (its mp3 still counts toward storage)">draft · not in feed</span>}
                  {SHOW_DRAFTS && (
                    <span class="row-ops">
                      <button type="button" class="row-op" data-op="to-notes" title="Move to notes (off the list)">→ note</button>
                      <button type="button" class="row-op danger" data-op="delete" title="Delete link, text and episode">✕</button>
                    </span>
                  )}
                </td>
                <td class="read">
                  <a href={i.url}>original</a>
                  <a href={`/feed/${i.slug}`}>md</a>
                </td>
                <td class="length">{fmtLength(i.duration)}</td>
                {SHOW_DRAFTS && (
                  <td class="size" title={fmtBytes(i.audioBytes ?? 0)}>
                    <span class="size-bar" style={`width:${((i.audioBytes ?? 0) / biggest) * 100}%`}></span>
                    <span class="size-num">{((i.audioBytes ?? 0) / 1e6).toFixed(1)}</span>
                  </td>
                )}
                <td class="listen">
                  <a class="listen-view" href={i.audio} title="listen">{listenIcon.ready}</a>
                  {SHOW_DRAFTS && (
                    <button type="button" class="listen-btn" data-state="ready"
                      title="narrated — click to delete the episode">✕</button>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>
  </div>
  </div>
</Base>

<script is:inline>
  (function () {
    const copy = document.getElementById('copy-feed');
    const url = document.getElementById('feed-url');
    if (copy && url) {
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url.textContent.trim());
          copy.textContent = 'copied';
        } catch {
          getSelection().selectAllChildren(url);
          copy.textContent = 'press ⌘/ctrl-C';
        }
        setTimeout(() => (copy.textContent = 'copy'), 1800);
      });
    }

    // Live extraction state for links without clean text yet (BacklogCast
    // reports it; see functions/_episodes.js). Distinguishes a "md" that's
    // still coming from one that failed. The owner script reuses the fetch.
    const titles = {
      in_progress: 'extracting clean text…',
      waiting: 'extraction failed — will retry',
      failed: 'extraction failed',
    };
    window.readingStatus = function () {
      return fetch('/api/episode-status', { credentials: 'include' })
        .then((r) => (r.ok ? r.json() : {}))
        .catch(() => ({}));
    };
    if (!document.querySelector('.read .pending')) return;
    window.readingStatusOnce = window.readingStatus();
    window.readingStatusOnce.then(({ text = {} }) => {
      document.querySelectorAll('.reading-table tbody tr[data-key]').forEach((row) => {
        const s = text[row.dataset.key];
        const md = row.querySelector('.read .pending');
        if (!s || !md || !titles[s.state]) return;
        md.dataset.text = s.state;
        md.title = titles[s.state] + (s.reason ? ': ' + s.reason : '');
      });
    });
  })();
</script>

{SHOW_DRAFTS && (
  <script is:inline define:vars={{ listenIcon }}>
    (function () {
      // Owner-mode editing: the add row, the hopper's LISTEN buttons, and
      // deleting episodes from the feed. Same auth pattern as the /books add
      // box — the Access cookie rides along; the shared token is only a 401
      // fallback.
      const API = '/api/reading';
      const TOKEN_KEY = 'lloydio_owner_token';
      const toggle = document.getElementById('feed-edit-toggle');
      const form = document.getElementById('add-reading');
      const page = document.querySelector('.feed-page');
      if (!toggle || !form || !page) return;
      const urlInput = form.querySelector('input[name=url]');
      const titleInput = form.querySelector('input[name=title]');
      const podcastInput = form.querySelector('input[name=podcast]');
      const msg = form.querySelector('.add-msg');

      const titles = {
        none: 'not queued — click to queue for narration',
        queued: 'queued — click to un-queue',
        in_progress: 'being narrated — click to cancel',
      };

      function setListen(row, state) {
        row.dataset.listen = state;
        const btn = row.querySelector('.hopper-table .listen-btn');
        if (!btn) return;
        const failed = row.dataset.failed ? ' (last attempt failed)' : '';
        btn.textContent = listenIcon[state];
        btn.title = (titles[state] || '') + failed;
        btn.dataset.state = state;
      }

      // Moves a hopper row into the section its state belongs to (newest first).
      function placeRow(row) {
        const id = row.dataset.listen === 'in_progress' ? 'queued' : row.dataset.listen;
        const tbody = document.querySelector('.reading-section[data-section="' + id + '"] tbody');
        if (!tbody) return;
        if (row.parentElement !== tbody) {
          const date = Number(row.dataset.date || Date.now());
          const after = [...tbody.rows].find((r) => Number(r.dataset.date || 0) < date);
          tbody.insertBefore(row, after || null);
        }
        recount();
      }

      const fmtBytes = (b) => (b >= 1e9 ? (b / 1e9).toFixed(2) + ' GB' : (b / 1e6).toFixed(b >= 1e8 ? 0 : 1) + ' MB');
      function recount() {
        let hopperN = 0;
        document.querySelectorAll('.reading-section').forEach((sec) => {
          const n = sec.querySelectorAll('tbody tr').length;
          hopperN += n;
          sec.querySelector('.count').textContent = n;
          if (n) delete sec.dataset.empty;
          else sec.dataset.empty = '';
        });
        const h = document.querySelector('[data-count="hopper"]');
        if (h) h.textContent = hopperN;
        const rows = document.querySelectorAll('.feed-table tbody tr');
        const f = document.querySelector('[data-count="feed"]');
        if (f) f.textContent = rows.length;
        // Storage meter follows the feed rows.
        const storage = document.querySelector('.storage');
        if (!storage) return;
        const used = [...rows].reduce((n, r) => n + Number(r.dataset.bytes || 0), 0);
        const left = Math.max(0, Number(storage.dataset.limit) - used);
        storage.querySelector('[data-storage="used"]').textContent = fmtBytes(used);
        storage.querySelector('[data-storage="left"]').textContent = fmtBytes(left);
        const more = storage.querySelector('[data-storage="more"]');
        if (more && rows.length) more.textContent = Math.floor(left / (used / rows.length));
      }

      // Meter segment ↔ table row highlight.
      page.addEventListener('mouseover', (ev) => {
        const el = ev.target.closest('.seg, .feed-table tbody tr');
        document.querySelectorAll('.hot').forEach((x) => x.classList.remove('hot'));
        if (!el) return;
        document.querySelectorAll('[data-key="' + CSS.escape(el.dataset.key) + '"]').forEach((x) => {
          if (x.matches('.seg, .feed-table tr')) x.classList.add('hot');
        });
      });

      toggle.addEventListener('click', () => {
        const on = toggle.getAttribute('aria-pressed') !== 'true';
        toggle.setAttribute('aria-pressed', String(on));
        toggle.textContent = on ? 'done' : 'edit';
        form.hidden = !on;
        page.classList.toggle('editing', on);
        if (on) {
          overlayLiveStatus(window.readingStatus());
          urlInput.focus();
        }
      });

      // "In progress" isn't in the repo — BacklogCast reports it live.
      async function overlayLiveStatus(pending) {
        try {
          const { statuses = {} } = await pending;
          document.querySelectorAll('.hopper-table tbody tr[data-key]').forEach((row) => {
            const s = statuses[row.dataset.key];
            if (!s) return;
            if (s.state === 'in_progress') setListen(row, 'in_progress');
            else if (s.state === 'failed') {
              row.dataset.failed = '1';
              setListen(row, row.dataset.listen);
            }
          });
        } catch {
          // live status is a nicety; the column still works without it
        }
      }
      document.querySelectorAll('.hopper-table tbody tr').forEach((r) => setListen(r, r.dataset.listen));
      overlayLiveStatus(window.readingStatusOnce || window.readingStatus());

      function post(payload, token) {
        const headers = { 'Content-Type': 'application/json' };
        if (token) headers.Authorization = 'Bearer ' + token;
        return fetch(API, { method: 'POST', headers, body: payload, credentials: 'include' });
      }

      async function send(body) {
        const payload = JSON.stringify(body);
        let res = await post(payload, localStorage.getItem(TOKEN_KEY) || '');
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          const t = (prompt('Not authenticated. Owner token (CAPTURE_TOKEN):') || '').trim();
          if (!t) throw new Error('unauthorized');
          localStorage.setItem(TOKEN_KEY, t);
          res = await post(payload, t);
          if (res.status === 401) {
            localStorage.removeItem(TOKEN_KEY);
            throw new Error('unauthorized — token rejected');
          }
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'request failed (' + res.status + ')');
        return data;
      }

      function say(text, kind) {
        msg.textContent = text;
        msg.dataset.kind = kind || '';
      }

      // Each action is a git commit; chain them so quick successive clicks don't race.
      let chain = Promise.resolve();
      function enqueue(task) {
        const run = chain.then(task, task);
        chain = run.then(() => {}, () => {});
        return run;
      }

      function dropRow(row) {
        const seg = document.querySelector('.seg[data-key="' + CSS.escape(row.dataset.key) + '"]');
        if (seg) seg.remove();
        row.remove();
        recount();
      }

      // ---- LISTEN buttons: queue / unqueue / cancel (hopper), delete (feed) ----
      const ops = { none: 'queue', queued: 'unqueue', in_progress: 'cancel', ready: 'delete' };
      page.addEventListener('click', (ev) => {
        const btn = ev.target.closest('.listen-btn');
        if (!btn) return;
        const row = btn.closest('tr');
        const op = ops[row.dataset.listen];
        const title = row.dataset.title || 'this item';
        if (op === 'cancel' && !confirm('Cancel narration of “' + title + '”?')) return;
        if (op === 'delete' && !confirm('Delete the episode for “' + title + '”?\n\nThis removes the audio and the narrated text; the link goes back to the hopper.')) return;
        btn.disabled = true;
        row.classList.add('saving');
        enqueue(async () => {
          try {
            const res = await send({
              action: 'listen',
              op,
              slug: row.dataset.key,
              notePath: row.dataset.note || undefined,
              articlePath: row.dataset.article || undefined,
              audio: row.dataset.audio || undefined,
            });
            delete row.dataset.failed;
            if (op === 'delete') {
              // Back in the hopper after the next rebuild.
              dropRow(row);
              return;
            }
            setListen(row, res.listen);
            placeRow(row);
            row.title = 'Saved — the site catches up after the next rebuild';
          } catch (e) {
            alert('Could not ' + op + ': ' + e.message);
          } finally {
            btn.disabled = false;
            row.classList.remove('saving');
          }
        });
      });

      // ---- remove / move to notes ----------------------------------------------
      page.addEventListener('click', (ev) => {
        const btn = ev.target.closest('.row-op');
        if (!btn) return;
        const row = btn.closest('tr');
        const op = btn.dataset.op;
        const title = row.dataset.title || 'this item';
        const extra = row.dataset.article
          ? '\n\nIts clean text' + (row.dataset.audio ? ' and episode audio' : '') + ' will be deleted.'
          : '';
        const ask = op === 'delete'
          ? 'Delete “' + title + '”?' + extra
          : 'Move “' + title + '” to notes? It leaves the feed and stays as a note.' + extra;
        if (!confirm(ask)) return;
        row.classList.add('saving');
        row.querySelectorAll('button').forEach((b) => (b.disabled = true));
        enqueue(async () => {
          try {
            await send({
              action: 'remove',
              op,
              slug: row.dataset.key,
              notePath: row.dataset.note || undefined,
              articlePath: row.dataset.article || undefined,
              audio: row.dataset.audio || undefined,
              url: row.dataset.url,
              title: row.dataset.title,
            });
            dropRow(row);
          } catch (e) {
            alert('Could not ' + (op === 'delete' ? 'delete' : 'move to notes') + ': ' + e.message);
            row.classList.remove('saving');
            row.querySelectorAll('button').forEach((b) => (b.disabled = false));
          }
        });
      });

      // ---- add row ------------------------------------------------------------
      // A placeholder row until the rebuild lists it for real.
      function placeholderRow(url, title, listen) {
        const tbody = document.querySelector('.reading-section[data-section="' + listen + '"] tbody');
        if (!tbody) return;
        const tr = document.createElement('tr');
        tr.className = 'just-added';
        tr.title = 'Added — appears for good after the site rebuilds';
        const titleTd = document.createElement('td');
        titleTd.className = 'title';
        titleTd.textContent = title || url;
        const readTd = document.createElement('td');
        readTd.className = 'read';
        const orig = document.createElement('a');
        orig.href = url;
        orig.textContent = 'original';
        const md = document.createElement('span');
        md.className = 'pending';
        md.textContent = 'md';
        readTd.append(orig, md);
        const listenTd = document.createElement('td');
        listenTd.className = 'listen';
        listenTd.textContent = listenIcon[listen];
        tr.append(titleTd, readTd, listenTd);
        tbody.prepend(tr);
        recount();
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const url = urlInput.value.trim();
        const title = titleInput.value.trim();
        const podcast = podcastInput.checked;
        if (!url) return;
        urlInput.value = '';
        titleInput.value = '';
        say('adding…');
        enqueue(async () => {
          try {
            const res = await send({ action: 'add', url, title, podcast });
            if (res.result === 'duplicate') {
              say('already on the list: ' + (res.title || url) + ' (' + res.status + ')', 'warn');
            } else {
              placeholderRow(url, title, res.listen);
              say(podcast
                ? 'added and queued for narration — BacklogCast picks it up after the next rebuild'
                : 'added — appears after the next rebuild', 'ok');
            }
          } catch (e) {
            say('add failed: ' + e.message, 'err');
          }
        });
        urlInput.focus();
      });
    })();
  </script>
)}

<style>
  /* Owner mode: hopper | feed side by side. Breaks out of the narrow reading
     column (same trick as /books' drafts), centered on the viewport. */
  .feed-grid { display: block; }
  @media (min-width: 60rem) {
    .feed-page.owner {
      width: min(94vw, 1400px);
      margin-left: calc(50% - min(94vw, 1400px) / 2);
    }
    .feed-page.owner .feed-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }
  }
  .feed-page.owner .feed-col { margin-top: 1.6rem; }
  @media (min-width: 60rem) { .feed-page.owner .feed-col { margin-top: 0; } }

  h2 { font-size: 1.2rem; margin: 0.4rem 0 0.2rem; }
  h2 .count, h3 .count { font-size: 0.8em; font-weight: normal; color: var(--muted); }
  .col-help { font-size: 0.85rem; color: var(--muted); margin: 0 0 0.4rem; }

  .feed-url {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em;
    margin: 0 0 0.3rem;
    font-size: 0.9rem;
  }
  .feed-url .label { font-variant: small-caps; color: var(--muted); }
  .feed-url code {
    overflow-wrap: anywhere;
    padding: 0.1em 0.4em;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.85em;
    user-select: all;
  }

  .chip {
    font-family: inherit;
    font-size: 0.85em;
    font-variant: small-caps;
    padding: 0.05em 0.55em;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    vertical-align: baseline;
  }
  .chip:hover,
  .chip[aria-pressed='true'] { border-color: var(--muted); color: var(--fg); }
  .edit-toggle { margin-left: 0.6em; }

  /* ---- storage meter ---- */
  .storage { margin: 0.3rem 0 0.9rem; }
  .meter {
    display: flex;
    height: 1.1rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    background: color-mix(in srgb, var(--muted) 6%, transparent);
  }
  .seg {
    flex: none;
    min-width: 2px;
    background: color-mix(in srgb, var(--fg) 70%, transparent);
    border-right: 1px solid var(--bg);
  }
