---
import Base from '../layouts/Base.astro';
import BookRow from '../components/BookRow.astro';
import { getCollection } from 'astro:content';
import { SHOW_DRAFTS, editUrl } from '../lib/site';

// books now live in one src/content/books.yaml (file loader).
const BOOKS_FILE = 'src/content/books.yaml';

const all = await getCollection('books', (e) => SHOW_DRAFTS || !e.data.draft);

// Public list never shows drafts, even in owner mode — drafts get their own
// section below so publishing is a deliberate act.
const books = all
  .filter((b) => !b.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const draftBooks = all
  .filter((b) => b.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const counts = books.reduce((m, b) => ((m[b.data.status] = (m[b.data.status] ?? 0) + 1), m), {});

// Collapsible sections, in reading-order.
const sections = [
  { status: 'reading', label: 'reading' },
  { status: 'to-read', label: 'to read' },
  { status: 'finished', label: 'read' },
] as const;
---
<Base title="Books">
  <h1 class="page-title">Books</h1>
  <p class="meta">
    <span data-total="finished">{counts.finished ?? 0}</span> read ·
    <span data-total="to-read">{counts['to-read'] ?? 0}</span> to read
    {(counts.reading || SHOW_DRAFTS) && (
      <> · <span data-total="reading">{counts.reading ?? 0}</span> reading</>
    )}
  </p>

  {books.length === 0 && <p>No books yet.</p>}

  {sections.map(({ status, label }) => {
    const group = books.filter((b) => b.data.status === status);
    // Owner mode renders every section, even an empty one, so the inline editor
    // has somewhere to move a row to.
    if (group.length === 0 && !SHOW_DRAFTS) return null;
    return (
      <details class="book-section" data-status={status} open>
        <summary>
          {label} <span class="count">{group.length}</span>
        </summary>
        {SHOW_DRAFTS && (
          <form class="add-book" data-status={status}>
            <input
              type="url"
              name="url"
              placeholder={`paste a Goodreads, Amazon or Audible link (or any other) to add to “${label}”`}
              aria-label={`Book link to add to ${label}`}
              autocomplete="off"
              required
            />
            <button type="submit" class="act">add</button>
            <span class="add-book-msg" role="status"></span>
          </form>
        )}
        <div style="overflow-x:auto">
          {/* Fixed layout + explicit column widths, so every section's
              columns line up exactly regardless of its contents. */}
          <table class:list={['book-table', { owner: SHOW_DRAFTS }]}>
            <colgroup>
              <col class="col-cover" />
              <col />
              <col class="col-status" />
              <col class="col-links" />
            </colgroup>
            <tbody>
              {group.map((b) => (
                <BookRow
                  id={b.id}
                  title={b.data.title}
                  author={b.data.author}
                  status={b.data.status}
                  rating={b.data.rating}
                  date={b.data.date}
                  cover={b.data.cover}
                  review={b.data.review}
                  links={b.data.links}
                  editable={SHOW_DRAFTS}
                />
              ))}
            </tbody>
          </table>
        </div>
      </details>
    );
  })}

  {SHOW_DRAFTS && (
    <p class="owner-help">
      Owner mode: hover a row and hit <strong>✎</strong> to change its status or
      rating. Rating a book files it under <strong>read</strong>.
    </p>
  )}

  {SHOW_DRAFTS && (
    <details class="book-section drafts-section" id="drafts" open>
      <summary>
        drafts <span class="count">{draftBooks.length}</span>
      </summary>
      <form class="add-book" data-status="to-read" data-draft="1">
        <input
          type="url"
          name="url"
          placeholder="paste a Goodreads, Amazon or Audible link (or any other) to add to drafts"
          aria-label="Book link to add to drafts"
          autocomplete="off"
          required
        />
        <button type="submit" class="act">add</button>
        <span class="add-book-msg" role="status"></span>
      </form>
      <div style="overflow-x:auto">
        <table>
          <tbody>
            {draftBooks.map((b) => (
              <BookRow
                id={b.id}
                title={b.data.title}
                author={b.data.author}
                status={b.data.status}
                rating={b.data.rating}
                date={b.data.date}
                cover={b.data.cover}
                review={b.data.review}
                links={b.data.links}
                actions={true}
                editHref={editUrl(BOOKS_FILE)}
              />
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}

  {SHOW_DRAFTS && draftBooks.length > 0 && (
    <dialog id="cleanup" aria-labelledby="cleanup-heading">
      <form method="dialog" class="cleanup-head">
        <h2 id="cleanup-heading">Clean up</h2>
        <button value="cancel" class="cleanup-x" aria-label="Close">✕</button>
      </form>
      <p class="cleanup-current"></p>
      <form class="cleanup-search">
        <input name="title" placeholder="title" aria-label="Title" autocomplete="off" required />
        <input name="author" placeholder="author (optional)" aria-label="Author" autocomplete="off" />
        <button type="submit" class="act">search</button>
      </form>
      <p class="cleanup-msg" role="status"></p>
      <ol class="cleanup-results"></ol>
      <div class="cleanup-foot">
        <button type="button" class="act" data-none>none of these</button>
        <button type="button" class="act primary" data-use disabled>use selected</button>
      </div>
    </dialog>
  )}
</Base>

{SHOW_DRAFTS && (
  <script is:inline>
    (function () {
      const API = '/api/books';
      const TOKEN_KEY = 'lloydio_owner_token';

      function post(payload, token) {
        const headers = { 'Content-Type': 'application/json' };
        if (token) headers.Authorization = 'Bearer ' + token;
        // Same-origin: the Cloudflare Access cookie rides along, so on the
        // owner site the request authenticates itself — no token to type.
        return fetch(API, { method: 'POST', headers, body: payload, credentials: 'include' });
      }

      async function send(ops) {
        const payload = JSON.stringify(ops.length === 1 ? ops[0] : { ops });
        let res = await post(payload, localStorage.getItem(TOKEN_KEY) || '');
        if (res.status === 401) {
          // Not signed in via Access — fall back to the shared token, once.
          localStorage.removeItem(TOKEN_KEY);
          const t = (prompt('Not authenticated. Owner token (CAPTURE_TOKEN):') || '').trim();
          if (!t) throw new Error('unauthorized');
          localStorage.setItem(TOKEN_KEY, t);
          res = await post(payload, t);
          if (res.status === 401) {
            localStorage.removeItem(TOKEN_KEY);
            throw new Error('unauthorized — token rejected');
          }
        }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'request failed (' + res.status + ')');
        return data;
      }

      // Serialize writes. Each request commits to git, so two in flight race on
      // the same base tree and the second 409s. Chain them so a click during an
      // in-flight action waits its turn instead of erroring.
      let queue = Promise.resolve();
      function enqueue(task) {
        const run = queue.then(task, task);
        // Keep the chain alive regardless of this task's outcome.
        queue = run.then(() => {}, () => {});
        return run;
      }

      function opFromRow(row, action) {
        const id = row.getAttribute('data-book-id');
        if (action === 'delete') return { action: 'delete', id };
        // One combined control encodes status and optional rating as
        // "status" or "finished:<rating>".
        const raw = row.querySelector('.draft-state')?.value || 'to-read';
        const [status, ratingVal] = raw.split(':');
        const op = { action: 'publish', id, status };
        if (ratingVal) op.rating = Number(ratingVal);
        return op;
      }

      function updateCount(delta) {
        const c = document.querySelector('#drafts > summary .count');
        if (!c) return;
        const n = Math.max(0, (parseInt(c.textContent, 10) || 0) + delta);
        c.textContent = String(n);
      }

      function setBusy(row, busy) {
        row.querySelectorAll('button, select, a.act').forEach((el) => {
          if (busy) el.setAttribute('disabled', '');
          else el.removeAttribute('disabled');
        });
        row.style.opacity = busy ? '0.5' : '';
      }

      // Delegated, so rows sent back to drafts this session work too.
      const draftsSection = document.getElementById('drafts');
      if (draftsSection) {
        draftsSection.addEventListener('click', async (ev) => {
          const btn = ev.target.closest('.book-row [data-act]');
          if (!btn) return;
          const row = btn.closest('.book-row');
          const action = btn.getAttribute('data-act');
          // Shift-click skips the confirm — for clearing many drafts quickly.
          if (action === 'delete' && !ev.shiftKey && !confirm('Discard this draft book permanently?')) return;
          setBusy(row, true);
          try {
            await enqueue(() => send([opFromRow(row, action)]));
            fadeOut(row);
            updateCount(-1);
          } catch (e) {
            alert(action + ' failed: ' + e.message);
            setBusy(row, false);
          }
        });
      }

      function fadeOut(row) {
        row.style.transition = 'opacity .3s';
        row.style.opacity = '0';
        setTimeout(() => row.remove(), 300);
      }

      // BookRow's truncateTitle (42 chars), for the auto-width drafts table.
      const truncTitle = (t) => (t.length > 43 ? t.slice(0, 42).trimEnd() + '…' : t);

      // ---- inline status/rating editor (published rows) ------------------
      // Local calendar date, not UTC: a late-evening rating shouldn't land on
      // tomorrow.
      const TODAY = new Date().toLocaleDateString('en-CA');
      const starStr = (n) => '★'.repeat(n) + '☆'.repeat(5 - n);

      function renderLabel(row, status, rating) {
        const label = row.querySelector('.state-label');
        if (!label) return;
        if (status === 'finished') {
          label.innerHTML = rating
            ? '<span class="stars" title="' + rating + '/5">' + starStr(rating) + '</span>'
            : '<span class="stars empty" title="unrated">☆☆☆☆☆</span>';
        } else {
          label.innerHTML = '<span class="status">' + status + '</span>';
        }
      }

      function bump(section, delta) {
        if (!section) return;
        const c = section.querySelector(':scope > summary .count');
        if (c) c.textContent = String(Math.max(0, (parseInt(c.textContent, 10) || 0) + delta));
        const total = document.querySelector('[data-total="' + section.dataset.status + '"]');
        if (total) total.textContent = String(Math.max(0, (parseInt(total.textContent, 10) || 0) + delta));
      }

      // Move a row into the section its new status belongs to, so the change is
      // visible immediately instead of after the site rebuilds.
      function moveRow(row, status) {
        const from = row.closest('.book-section');
        const to = document.querySelector('.book-section[data-status="' + status + '"]');
        if (!to || to === from) return;
        to.querySelector('tbody').prepend(row);
        bump(from, -1);
        bump(to, 1);
      }

      function closeEditor(row) {
        row.classList.remove('editing');
        const sel = row.querySelector('.row-state');
        if (sel) sel.hidden = true;
      }

      document.querySelectorAll('.book-row [data-act="edit-state"]').forEach((btn) => {
        const row = btn.closest('.book-row');
        const sel = row.querySelector('.row-state');
        if (!sel) return;
        sel.dataset.saved = sel.value;

        btn.addEventListener('click', () => {
          row.classList.add('editing');
          sel.hidden = false;
          sel.focus();
        });

        sel.addEventListener('keydown', (ev) => {
          if (ev.key === 'Escape') {
            sel.value = sel.dataset.saved || sel.value;
            closeEditor(row);
          }
        });
        sel.addEventListener('blur', () => closeEditor(row));

        sel.addEventListener('change', async () => {
          if (sel.value === 'draft') return unpublish(row, sel);
          const [status, ratingVal] = sel.value.split(':');
          const rating = ratingVal ? Number(ratingVal) : null;
          const op = { action: 'update', id: row.getAttribute('data-book-id'), status, rating };
          // Rating a book (or otherwise marking it read) stamps today as the
          // date it was finished.
          if (status === 'finished') op.date = TODAY;
          row.classList.add('saving');
          try {
            await enqueue(() => send([op]));
            sel.dataset.saved = sel.value;
            renderLabel(row, status, rating);
            closeEditor(row);
            moveRow(row, status);
          } catch (e) {
            alert('save failed: ' + e.message);
            sel.value = sel.dataset.saved || sel.value;
          } finally {
            row.classList.remove('saving');
          }
        });
      });

      // "↩ back to drafts": flag the entry `draft: true` again and move the
      // row into the drafts table now (rebuilt as a draft row: status picker,
      // publish, clean up, edit, ✕), ahead of the site rebuild.
      async function unpublish(row, sel) {
        const id = row.getAttribute('data-book-id');
        const state = sel.dataset.saved || 'to-read';
        row.classList.add('saving');
        try {
          await enqueue(() => send([{ action: 'unpublish', id }]));
        } catch (e) {
          alert('move to drafts failed: ' + e.message);
          sel.value = state;
          row.classList.remove('saving');
          closeEditor(row);
          return;
        }
        const from = row.closest('.book-section');
        const proto = document.querySelector('#drafts .book-row');
        bump(from, -1);
        if (!proto) {
          // No drafts table on this build — it shows up after the rebuild.
          fadeOut(row);
          return;
        }
        const draft = proto.cloneNode(true);
        draft.removeAttribute('style');
        draft.classList.remove('saving', 'editing');
        // Keep this book's cover and title/author cells; take the action cell
        // from the prototype draft row.
        draft.querySelector('.book-cover').replaceWith(row.querySelector('.book-cover'));
        draft.querySelector('.book-title-author').replaceWith(row.querySelector('.book-title-author'));
        // The drafts table sizes to its content, so cap the title like
        // BookRow does there.
        const t = draft.querySelector('.title');
        if (t) t.textContent = truncTitle(t.title || t.textContent);
        draft.querySelectorAll('button, select, a.act').forEach((el) => el.removeAttribute('disabled'));
        draft.setAttribute('data-book-id', id);
        const pick = draft.querySelector('.draft-state');
        if (pick) pick.value = state;
        draft.classList.add('just-added');
        draft.title = 'Sent back to drafts — appears here for good after the site rebuilds';
        row.remove();
        document.querySelector('#drafts tbody').prepend(draft);
        updateCount(1);
      }

      // ---- add a book from an Amazon link ---------------------------------
      // Every section (and drafts) has an always-visible add box. The
      // server looks the link up right away; a confident hit is committed as a
      // published entry, a guess lands in drafts, and an unreadable link is
      // queued as an inbox note for process-inbox.
      const addForms = Array.from(document.querySelectorAll('form.add-book'));

      // A placeholder row for a just-added book, shown until the rebuild lands.
      // Cloning a rendered row keeps BookRow's scoped styles.
      function placeholderRow(entry) {
        const proto = document.querySelector('.book-section[data-status] .book-row');
        let row;
        if (proto) {
          row = proto.cloneNode(true);
          row.querySelectorAll('.book-review, .state-edit, .row-state').forEach((el) => el.remove());
          // Re-point the cloned shop icons at this book's links, with the
          // same specific-vs-search styling BookRow applies.
          row.querySelectorAll('.book-links .shop').forEach((el) => {
            const kind = ['goodreads', 'amazon', 'audible'].find((k) => el.classList.contains(k));
            const href = entry.links && entry.links[kind];
            const shop = document.createElement(href ? 'a' : 'span');
            for (const at of el.attributes) shop.setAttribute(at.name, at.value);
            shop.innerHTML = el.innerHTML;
            shop.classList.remove('search', 'missing');
            const name = kind[0].toUpperCase() + kind.slice(1);
            if (href) {
              shop.href = href;
              const specific =
                kind === 'goodreads' ? href.includes('/book/show/')
                : kind === 'amazon' ? /\/(dp|gp)\//.test(href)
                : !/[?&]keywords=|\/search\b/.test(href);
              if (!specific) shop.classList.add('search');
              shop.title = name + (specific ? '' : ' (search)');
            } else {
              shop.classList.add('missing');
              shop.title = name + ' (no link)';
            }
            el.replaceWith(shop);
          });
          let img = row.querySelector('.cover-image');
          if (entry.cover) {
            if (!img) {
              img = document.createElement('img');
              img.className = 'cover-image';
              row.querySelector('.book-cover').append(img);
            }
            img.src = entry.cover;
          } else if (img) {
            img.remove();
          }
        } else {
          row = document.createElement('tr');
          row.className = 'book-row';
          row.innerHTML =
            '<td class="book-cover"></td><td class="book-title-author"><div class="title"></div>' +
            '<div class="author"></div></td><td class="book-status"><span class="state-label"></span></td>';
        }
        row.setAttribute('data-book-id', entry.id);
        row.querySelector('.title').textContent = entry.title;
        row.querySelector('.title').title = entry.title;
        row.querySelector('.author').textContent = entry.author || '';
        renderLabel(row, entry.status, null);
        // renderLabel's fresh spans lack BookRow's scoped-style attribute.
        const label = row.querySelector('.state-label');
        if (label) {
          const cid = Array.from(label.attributes).find((a) => a.name.startsWith('data-astro-cid'));
          if (cid) label.querySelectorAll('*').forEach((el) => el.setAttribute(cid.name, ''));
        }
        row.classList.add('just-added');
        row.title = 'Added — appears for good after the site rebuilds';
        return row;
      }

      function say(form, text, kind) {
        const msg = form.querySelector('.add-book-msg');
        msg.textContent = text;
        msg.dataset.kind = kind || '';
      }

      addForms.forEach((form) => {
        const input = form.querySelector('input');
        const status = form.dataset.status;
        const section = form.closest('.book-section');

        form.addEventListener('submit', async (ev) => {
          ev.preventDefault();
          const url = input.value.trim();
          if (!url) return;
          form.classList.add('busy');
          input.disabled = true;
          say(form, 'looking it up…');
          try {
            const asDraft = form.dataset.draft === '1';
            const res = await enqueue(() => send([{ action: 'add', url, status, draft: asDraft || undefined }]));
            if (res.result === 'added') {
              section.querySelector('tbody').prepend(placeholderRow(res.entry));
              bump(section, 1);
              say(form, 'added “' + res.entry.title + '”', 'ok');
            } else if (res.result === 'drafted' && asDraft) {
              say(form, 'saved “' + res.entry.title + '” to drafts — shows after the rebuild', 'ok');
            } else if (res.result === 'drafted') {
              say(form, 'saved “' + res.entry.title + '” as a draft — the lookup was a guess, check it under drafts after the rebuild', 'warn');
            } else if (res.result === 'queued') {
              say(form, 'couldn’t read that link directly — queued as an inbox note — ask Claude to process the inbox', 'warn');
            } else if (res.result === 'duplicate') {
              say(form, 'already listed: ' + res.title, 'warn');
            } else {
              say(form, 'done');
            }
            input.value = '';
          } catch (e) {
            say(form, 'add failed: ' + e.message, 'err');
          } finally {
            form.classList.remove('busy');
            input.disabled = false;
            input.focus();
          }
        });

        // Pasting a link is the whole interaction — submit straight away.
        input.addEventListener('paste', () => {
          setTimeout(() => {
            if (input.value.trim() && input.checkValidity()) form.requestSubmit();
          }, 0);
        });
      });

      // ---- clean up a wrong draft ----------------------------------------
      // "clean up" opens a picker of up to 10 listings (Open Library print
      // editions + Audible audiobooks, which name authors and narrators
      // separately). Picking one rewrites the entry as that listing — new id,
      // title, author, cover, links; status/date/draft are kept.
      const dlg = document.getElementById('cleanup');
      if (dlg) {
        const searchForm = dlg.querySelector('.cleanup-search');
        const titleInput = searchForm.querySelector('[name="title"]');
        const authorInput = searchForm.querySelector('[name="author"]');
        const list = dlg.querySelector('.cleanup-results');
        const msg = dlg.querySelector('.cleanup-msg');
        const useBtn = dlg.querySelector('[data-use]');
        let row = null;
        let results = [];
        let searchSeq = 0;

        // Main title only: drop "(Series #1)" / "[Dramatized]" tags and
        // anything after a subtitle colon or a spaced dash.
        const mainTitle = (t) =>
          t.replace(/\s*[([][^)\]]*[)\]]/g, ' ').split(/:|\s[-–—―]\s/)[0].replace(/\s+/g, ' ').trim();

        const say = (text) => { msg.textContent = text; };

        function render() {
          list.textContent = '';
          results.forEach((c, i) => {
            const li = document.createElement('li');
            const label = document.createElement('label');
            const radio = document.createElement('input');
            radio.type = 'radio';
            radio.name = 'cleanup-pick';
            radio.value = String(i);
            radio.addEventListener('change', () => { useBtn.disabled = false; });

            const thumb = document.createElement('span');
            thumb.className = 'thumb';
            if (c.cover) {
              const img = document.createElement('img');
              img.alt = '';
              img.loading = 'lazy';
              img.src = c.cover;
              // Missing covers come back as 1×1 placeholders or 404s.
              img.onload = () => { if (img.naturalWidth < 5) img.remove(); };
              img.onerror = () => img.remove();
              thumb.append(img);
            }

            const info = document.createElement('span');
            info.className = 'info';
            const t = document.createElement('strong');
            t.textContent = c.title;
            const by = document.createElement('span');
            by.className = 'by';
            by.textContent = c.author ? 'by ' + c.author : 'no author listed';
            info.append(t, by);
            if (c.narrators) {
              const n = document.createElement('span');
              n.className = 'narr';
              n.textContent = 'narrated by ' + c.narrators;
              info.append(n);
            }
            const meta = document.createElement('span');
            meta.className = 'meta-line';
            meta.textContent = [c.format, c.year, c.edition, c.asin].filter(Boolean).join(' · ') + ' ';
            const view = document.createElement('a');
            view.href = c.url;
            view.target = '_blank';
            view.rel = 'noopener noreferrer';
            view.textContent = (c.format === 'print' ? 'Amazon' : 'Audible') + ' ↗';
            meta.append(view);
            info.append(meta);

            label.append(radio, thumb, info);
            li.append(label);
            list.append(li);
          });
        }

        async function runSearch() {
          const seq = ++searchSeq;
          const title = titleInput.value.trim();
          const author = authorInput.value.trim();
          if (!title) return;
          results = [];
          render();
          useBtn.disabled = true;
          say('searching…');
          try {
            // Read-only, so it skips the write queue.
            const res = await send([{ action: 'search', id: row.getAttribute('data-book-id'), title, author }]);
            if (seq !== searchSeq) return; // a newer search superseded this one
            results = res.results || [];
            render();
            say(
              results.length
                ? results.length + ' listing' + (results.length === 1 ? '' : 's') + ' — pick one, or “none of these”.'
                : 'No listings found. Try a shorter title, or clear the author.'
            );
          } catch (e) {
            if (seq === searchSeq) say('search failed: ' + e.message);
          }
        }

        function openCleanup(r) {
          row = r;
          const titleEl = row.querySelector('.title');
          const title = titleEl.getAttribute('title') || titleEl.textContent;
          const author = (row.querySelector('.author')?.textContent || '').trim();
          dlg.querySelector('.cleanup-current').textContent =
            'Now: “' + title + '”' + (author ? ' — ' + author : ' — no author');
          // The current author may be a narrator; it still helps Audible find
          // the exact recording, and Open Library retries without it.
          titleInput.value = mainTitle(title) || title;
          authorInput.value = author;
          dlg.showModal();
          runSearch();
        }

        // Apply the new entry to the row now, ahead of the rebuild.
        function applyEntry(r, entry) {
          r.setAttribute('data-book-id', entry.id);
          const titleEl = r.querySelector('.title');
          titleEl.textContent = truncTitle(entry.title);
          titleEl.title = entry.title;
          const authorEl = r.querySelector('.author');
          if (authorEl) authorEl.textContent = entry.author || '';
          const cell = r.querySelector('.book-cover');
          let img = r.querySelector('.cover-image');
          if (entry.cover) {
            if (!img) {
              img = document.createElement('img');
              img.className = 'cover-image';
              img.alt = '';
              // Carry BookRow's scoped-style attribute over to the new node.
              for (const a of cell.attributes) if (a.name.startsWith('data-astro-cid')) img.setAttribute(a.name, '');
              cell.append(img);
            }
            img.src = entry.cover;
          } else if (img) {
            img.remove();
          }
          r.classList.add('just-added');
          r.title = 'Cleaned up — appears for good after the site rebuilds';
        }

        searchForm.addEventListener('submit', (ev) => {
          ev.preventDefault();
          runSearch();
        });

        dlg.querySelector('[data-none]').addEventListener('click', () => dlg.close());
        dlg.addEventListener('close', () => {
          searchSeq++; // ignore any search still in flight
          results = [];
          list.textContent = '';
          say('');
        });

        useBtn.addEventListener('click', async () => {
          const checked = list.querySelector('input[name="cleanup-pick"]:checked');
          if (!checked || !row) return;
          const pick = results[Number(checked.value)];
          const r = row;
          const id = r.getAttribute('data-book-id');
          useBtn.disabled = true;
          say('saving…');
          try {
            const res = await enqueue(() => send([{ action: 'replace', id, pick }]));
            if (res.result === 'duplicate') {
              dlg.close();
              if (confirm('That listing is already in your books as “' + res.title + '”. Discard this draft instead?')) {
                setBusy(r, true);
                await enqueue(() => send([{ action: 'delete', id }]));
                r.style.transition = 'opacity .3s';
                r.style.opacity = '0';
                setTimeout(() => r.remove(), 300);
                updateCount(-1);
              }
              return;
            }
            applyEntry(r, res.entry);
            dlg.close();
          } catch (e) {
            say('save failed: ' + e.message);
            useBtn.disabled = false;
          }
        });

        draftsSection.addEventListener('click', (ev) => {
          const btn = ev.target.closest('.book-row [data-cleanup]');
          if (btn) openCleanup(btn.closest('.book-row'));
        });
      }

    })();
  </script>
)}

<style>
  .book-section {
    border: none;
    padding: 0;
    margin: 1.2rem 0;
  }
  .book-section > summary {
    cursor: pointer;
    font-variant: small-caps;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.2rem;
    list-style: none;
  }
  .book-section > summary::-webkit-details-marker { display: none; }
  .book-section > summary::before { content: '▸ '; color: var(--muted); font-size: 0.8em; }
  .book-section[open] > summary::before { content: '▾ '; }
  .book-section > summary .count { color: var(--faint); font-size: 0.85rem; }
  .book-section table { margin-top: 0.4rem; }

  /* Public sections share one column grid. The title column takes whatever
     the fixed columns leave. Status fits five stars (owner mode: plus the ✎
     button); the edit dropdown shrinks to fit rather than widening it. */
  .book-table {
    width: 100%;
    table-layout: fixed;
  }
  .col-cover { width: 44px; }
  .col-status { width: 5.2rem; }
  .col-links { width: 5.6rem; }
  .book-table.owner .col-status { width: 6.6rem; }

  /* Per-section "add from link" box. */
  .add-book {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4em;
    margin: 0.5rem 0 0.2rem;
  }
  .add-book input {
    /* Override the global `width:100%` form rule; flex sizes it instead. */
    width: auto;
    flex: 1 1 16rem;
    min-width: 0;
    font-size: 0.85rem;
    padding: 0.25em 0.5em;
  }
  .add-book .act {
    font-family: inherit;
    font-size: 0.85rem;
    padding: 0.2em 0.7em;
    border: 1px solid var(--muted);
    border-radius: 4px;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  .add-book.busy { opacity: 0.6; }
  .add-book-msg {
    flex-basis: 100%;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .add-book-msg:empty { display: none; }
  .add-book-msg[data-kind='ok'] { color: var(--fg); }
  .add-book-msg[data-kind='err'] { color: #b00020; }
  /* A row added this session, before the rebuild makes it permanent. */
  .book-section :global(.book-row.just-added) {
    background: color-mix(in srgb, var(--muted) 10%, transparent);
  }

  /* Owner-only drafts bucket: set apart from the public sections. */
  .drafts-section {
    margin-top: 2.4rem;
    padding: 0.6rem 0.9rem 0.9rem;
    border: 1px dashed var(--border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--muted) 6%, transparent);
  }
  /* Break out of the narrow reading column so every column is visible
     without a horizontal scroll; stays centered on the viewport. */
  @media (min-width: 60rem) {
    .drafts-section {
      width: min(94vw, 1400px);
      margin-left: calc(50% - min(94vw, 1400px) / 2);
    }
  }
  /* Size columns to their content — no wider than necessary. */
  .drafts-section table {
    width: auto;
  }
  .drafts-section > summary { color: var(--muted); }
  .owner-help {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 1.4rem 0 0;
  }
</style>

